# Override host bind address (default: 127.0.0.1 — local-only).
# WARNING: exposing an unauthenticated proxy on a public interface is dangerous.
# See readme.md for the risks. Prefer with_authentication or an SSH tunnel.
#SQUID_BIND=127.0.0.1

# Override host port (default: 3128). Useful when 3128 is already in use.
#SQUID_PORT=3128
